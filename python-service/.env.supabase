# Supabase Configuration for Python Service

DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password_here
DB_SSL_MODE=require

# Connection pool settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT=10

# Embedding Configuration
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIMENSION=768

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/embedding-service.log

# Security
ENCRYPTION_SALT_LENGTH=16
PBKDF2_ITERATIONS=100000

# Performance
BATCH_SIZE=32
CACHE_TTL=86400
MAX_WORKERS=4
